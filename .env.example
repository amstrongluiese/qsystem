# ── Database ──────────────────────────────────────────────────────────────────
# Required. Your PostgreSQL connection string.
DATABASE_URL=postgres://user:password@localhost:5432/qsystem

# ── Server ────────────────────────────────────────────────────────────────────
# Port the server listens on (default: 8080)
PORT=8080

# Set to production to enable single-server mode (Express serves the React app)
NODE_ENV=production

# ── Security ──────────────────────────────────────────────────────────────────
# Admin dashboard password (default: admin123)
ADMIN_PASSWORD=admin123

# Session secret — change this to any long random string
SESSION_SECRET=change-me-to-a-long-random-string

# ── Advanced (optional) ───────────────────────────────────────────────────────
# Override path to the built React app (default: auto-detected)
# FRONTEND_DIST=/absolute/path/to/enrollment-system/dist/public
